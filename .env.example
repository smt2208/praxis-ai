# ── Server & Runtime ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
APP_BASE_URL=https://praxisapp.online
MAX_CONTEXT_CHARS=120000

# ── Security & Authentication (JWT) ───────────────────────────────────────────
SECRET_KEY=generate-a-strong-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL Database (AWS RDS / Local) ─────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=praxis

# ── Vector Database (Qdrant) ──────────────────────────────────────────────────
QDRANT_URL=https://your-qdrant-instance.qdrant.tech:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=collection

# ── AI & Reasoning Providers ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-api-key
LLAMA_CLOUD_API_KEY=llx-your-llama-cloud-key
MEM0_COLLECTION_NAME=praxis_memories

# ── Web Search Providers (LangGraph Web Search Subgraph) ──────────────────────
# Firecrawl: Live, fresh web search, news, and markdown page extraction
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key
# Tavily: Broad general web search and fact extraction
TAVILY_API_KEY=tvly-your-tavily-api-key
# Exa: Neural semantic search and deep research
EXA_API_KEY=your-exa-api-key

# ── Email Service (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=onboarding@praxisapp.online
RESEND_FROM_NAME=Praxis

# ── Observability & Tracing (LangSmith) ────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key
LANGCHAIN_PROJECT=praxis-ai

# ── Object Storage (AWS S3) ───────────────────────────────────────────────────
# If running on AWS EC2 with an IAM Role, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=your-praxis-chat-images-bucket
AWS_S3_REGION=us-east-1

